# Map tiles are fetched in the browser; use a public MapTiler key with origin restrictions.
NEXT_PUBLIC_MAPTILER_KEY=

# Local Supabase Postgres started by `bun run db:start`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional Supabase Auth for assigned safety moderators. Public sign-up is disabled locally.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback during migration only:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
SAFETY_MODERATOR_EMAILS=
# Optional HMAC salt for short-lived anonymous-report rate-limit identifiers.
SAFETY_REPORT_HASH_SECRET=
