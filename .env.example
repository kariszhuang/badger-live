# Public browser configuration. MapTiler is optional; OpenFreeMap is the fallback.
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Use the local Supabase Postgres URL for disposable development.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
OPENAI_API_KEY=
# Documented OpenAI model ID; verify it is enabled for the target project.
OPENAI_REPORT_MODEL=gpt-6-luna
OPENAI_ASSISTANT_MODEL=
REPORT_FINGERPRINT_HMAC_KEY=
REPORT_CAPABILITY_HMAC_KEY=
CRON_SECRET=

# Fail closed until local database, moderation/model access, and HMAC keys work.
REPORT_WRITES_ENABLED=false
